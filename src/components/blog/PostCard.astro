---
import { formatPostDate, isoDay, readingTime, type Post } from '../../lib/blog'

interface Props {
  post: Post
  headingLevel?: 'h2' | 'h3'
}

const { post, headingLevel: Heading = 'h2' } = Astro.props
const { title, description, pubDate, tags } = post.data
---

<article class='card' data-reveal=''>
  <Heading class='title'>
    <a href={`/blog/${post.id}/`}>{title}</a>
  </Heading>
  <p class='meta'>
    <time datetime={isoDay(pubDate)}>{formatPostDate(pubDate)}</time>
    <span aria-hidden='true'>·</span>
    <span>{readingTime(post.body)}</span>
  </p>
  <p class='description'>{description}</p>
  {tags.length > 0 && (
    <ul aria-label='Etiquetas' class='tags'>
      {tags.map(tag => <li>#{tag}</li>)}
    </ul>
  )}
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px 26px;
    background: var(--surface);
    border: 1.5px solid var(--paper-border-strong);
    border-radius: var(--radius-card);
    transition: box-shadow 0.3s var(--ease-out), translate 0.3s var(--ease-out), opacity 0.7s var(--ease-out) var(--delay, 0s), transform 0.7s var(--ease-out) var(--delay, 0s);
  }
  .card:hover, .card:focus-within { translate: -2px -2px; box-shadow: 5px 6px 0 var(--shadow-ink); }

  .title { font-size: 24px; line-height: 1.2; }
  .title a { text-decoration: none; }
  /* The whole card is clickable through the title link */
  .title a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }

  .meta { display: flex; gap: 8px; flex-wrap: wrap; font-size: 14px; color: var(--ink-light); }
  .description { color: var(--ink-light); }

  .tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 12px; font-family: var(--font-hand); font-size: 20px; color: var(--olive); }
</style>
