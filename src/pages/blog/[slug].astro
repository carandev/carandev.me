---
import type { GetStaticPaths } from 'astro'
import { Image } from 'astro:assets'
import { render } from 'astro:content'
import { SkipLink } from '@carandev/trazos-ui'

import Layout from '../../layouts/Layout.astro'
import { Navbar } from '../../components/Navbar'
import { Footer } from '../../components/Footer'
import { formatPostDate, getPublishedPosts, isoDay, readingTime, type Post } from '../../lib/blog'

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts()

  return posts.map(post => ({ params: { slug: post.id }, props: { post } }))
}) satisfies GetStaticPaths

interface Props {
  post: Post
}

const { post } = Astro.props
const { title, description, pubDate, updatedDate, tags, cover } = post.data
const { Content } = await render(post)
---

<Layout description={description} title={`${title} | Carlos Gómez`}>
  <SkipLink href='#contenido'>Saltar al contenido</SkipLink>
  <Navbar client:load current='blog' />
  <main class='container article' id='contenido'>
    <a class='back' href='/blog/'>← Todos los artículos</a>

    <article>
      <header class='header'>
        <h1 class='title'>{title}</h1>
        <p class='meta'>
          <time datetime={isoDay(pubDate)}>{formatPostDate(pubDate)}</time>
          {updatedDate && <span>· actualizado el <time datetime={isoDay(updatedDate)}>{formatPostDate(updatedDate)}</time></span>}
          <span>· {readingTime(post.body)}</span>
        </p>
        {tags.length > 0 && (
          <ul aria-label='Etiquetas' class='tags'>
            {tags.map(tag => <li>#{tag}</li>)}
          </ul>
        )}
      </header>

      {cover && <Image alt='' class='cover' loading='eager' src={cover} width={1200} />}

      <div class='prose'>
        <Content />
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .article { display: flex; flex-direction: column; gap: 24px; max-width: 760px; padding-top: 120px; padding-bottom: 48px; }
  .back { color: var(--wine); font-weight: 600; text-decoration: none; }
  .back:hover { text-decoration: underline; }

  .header { display: flex; flex-direction: column; gap: 12px; margin-bottom: 24px; }
  .title { font-size: clamp(34px, 5vw, 48px); line-height: 1.1; }
  .meta { display: flex; flex-wrap: wrap; gap: 6px; color: var(--ink-light); font-size: 15px; }
  .tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 12px; font-family: var(--font-hand); font-size: 22px; color: var(--olive); }

  .cover { width: 100%; height: auto; border-radius: var(--radius-card); border: 1.5px solid var(--paper-border-strong); margin-bottom: 24px; }

  /* MDX output is not scoped, so the article typography targets it globally inside .prose */
  .prose { font-size: 18px; line-height: 1.75; overflow-wrap: break-word; }
  .prose :global(> * + *) { margin-top: 1.1em; }
  .prose :global(h2) { font-size: 30px; line-height: 1.2; margin-top: 1.8em; }
  .prose :global(h3) { font-size: 24px; line-height: 1.25; margin-top: 1.5em; }
  .prose :global(a) { color: var(--wine); text-underline-offset: 3px; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.4em; }
  .prose :global(li + li) { margin-top: 0.35em; }
  .prose :global(blockquote) { margin-inline: 0; padding: 4px 0 4px 18px; border-left: 3px solid var(--gold); color: var(--ink-light); font-style: italic; }
  .prose :global(:not(pre) > code) { font-size: 0.9em; padding: 2px 6px; border-radius: 6px; background: var(--paper-200); }
  .prose :global(pre) { padding: 18px 20px; border-radius: var(--radius-sm); border: 1.5px solid var(--paper-border-strong); overflow-x: auto; font-size: 15px; line-height: 1.6; }
  .prose :global(img) { height: auto; border-radius: var(--radius-sm); }
  .prose :global(hr) { border: none; border-top: 1.5px dashed var(--paper-border-strong); margin-block: 2em; }
</style>
